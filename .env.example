# Copy this file to .env and fill in your values
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
MAX_AGENT_STEPS=5
LOG_LEVEL=INFO
CHROMA_DB_PATH=./data/chroma_db
TRACE_DB_PATH=./data/traces.db
API_URL=http://localhost:8000

# Embedding provider: "transformers" (default, local, no Ollama needed)
# or "ollama" (requires Ollama running with nomic-embed-text pulled)
# NOTE: switching providers requires deleting chroma_db/ to avoid dimension mismatch
EMBEDDING_PROVIDER=transformers
